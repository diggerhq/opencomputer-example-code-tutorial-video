{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "opencomputer-code-tutorial-artifacts",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-27",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"r2_buckets": [
		{
			"binding": "VIDEOS",
			"bucket_name": "opencomputer-code-tutorial-videos"
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	}
}
